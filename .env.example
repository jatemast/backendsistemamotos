# Entorno
NODE_ENV=development
PORT=4000

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taller_motos_pavas
DB_USER=taller_user
DB_PASSWORD=cambia_esta_clave

# CORS - dominio del frontend en produccion
CORS_ORIGIN=http://localhost:5173

# Autenticacion (JWT) - genera una clave larga y aleatoria para produccion
# Ejemplo para generarla: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
